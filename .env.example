# Production: NODE_ENV=production. PORT is injected by the host (Render); 3334 is the local default.
NODE_ENV=development
PORT=3334

# Control Plane MySQL (own database — never the Core DB)
DATABASE_URL=mysql://super_admin:super_admin@127.0.0.1:3307/loor_super_admin

# Operator JWT (frontend → Nest)
JWT_SECRET=change-me-super-admin-jwt-secret
JWT_EXPIRES_IN=8h

# Service-to-service (Nest → Core) — never exposed to frontend
LOOR_CORE_BASE_URL=http://127.0.0.1:3333
LOOR_CORE_SERVICE_CLIENT_ID=loor-super-admin
LOOR_CORE_SERVICE_SECRET=change-me-service-jwt-secret
LOOR_CORE_SERVICE_ISSUER=loor-super-admin
LOOR_CORE_SERVICE_AUDIENCE=loor-core
LOOR_CORE_TIMEOUT_MS=10000
LOOR_CORE_JWT_TTL_SECONDS=60

# Comma-separated list of allowed origins. Empty = reflect any origin (dev only) - always set in production.
CORS_ORIGIN=http://localhost:5173
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
LOG_LEVEL=info

# Dev seed only (ignored when empty / production)
SEED_SUPER_ADMIN_EMAIL=superadmin@loor.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMeDevOnly!123
SEED_SUPER_ADMIN_NAME=LOOR Super Admin
