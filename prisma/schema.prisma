generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SuperAdminStatus {
  ACTIVE
  INACTIVE
}

enum RoleSlug {
  SUPER_ADMIN
  FINANCIAL_ADMIN
  COMPLIANCE_ADMIN
  SUPPORT_ADMIN
  READ_ONLY
}

model SuperAdmin {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String           @map("password_hash")
  status       SuperAdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?        @map("last_login_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  roles         SuperAdminRole[]
  auditLogs     AuditLog[]
  provisionings WhitelabelProvisioning[]

  @@map("super_admins")
}

model Role {
  id          String   @id @default(cuid())
  name        String
  slug        RoleSlug @unique
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions PermissionRole[]
  superAdmins SuperAdminRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles PermissionRole[]

  @@map("permissions")
}

model SuperAdminRole {
  id           String @id @default(cuid())
  superAdminId String @map("super_admin_id")
  roleId       String @map("role_id")

  superAdmin SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([superAdminId, roleId])
  @@map("super_admin_roles")
}

model PermissionRole {
  id           String @id @default(cuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("permission_roles")
}

model AuditLog {
  id            String   @id @default(cuid())
  superAdminId  String?  @map("super_admin_id")
  action        String
  resourceType  String?  @map("resource_type")
  resourceId    String?  @map("resource_id")
  whitelabelId  Int?     @map("whitelabel_id")
  beforeData    Json?    @map("before_data")
  afterData     Json?    @map("after_data")
  result        String?
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(512)
  correlationId String?  @map("correlation_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")

  superAdmin SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([resourceType])
  @@index([whitelabelId])
  @@index([correlationId])
  @@map("audit_logs")
}

/// Global Super Admin sidebar visibility (homolog governance). Not RBAC.
model MenuVisibilityConfig {
  id         String   @id @default("global")
  scope      String   @default("global") @db.VarChar(32)
  visibility Json
  version    Int      @default(0)
  updatedBy  String?  @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("menu_visibility_configs")
}

enum ProvisioningStatus {
  PENDING
  RUNNING
  WAITING_MANUAL_ACTION
  FAILED
  COMPLETED
  CANCELLED
}

enum ProvisioningStepStatus {
  PENDING
  RUNNING
  WAITING_MANUAL_ACTION
  SUCCESS
  FAILED
  SKIPPED
}

enum ProvisioningStepKey {
  CREATE_TENANT
  APPLY_SETTINGS_TEMPLATE
  UPLOAD_BRAND
  INITIAL_ADMIN
  TERMS
  SMTP
  GATEWAY_CONFIG
  FE_DEPLOY_CHECK
  DNS_CHECK
  VALIDATE
  DELIVER
}

/// Control-plane-only orchestration state for Whitelabel onboarding. Core DB is never touched here.
model WhitelabelProvisioning {
  id                       String               @id @default(cuid())
  whitelabelId             Int?                 @map("whitelabel_id")
  name                     String
  slug                     String               @db.VarChar(80)
  baseUrl                  String               @map("base_url") @db.VarChar(512)
  status                   ProvisioningStatus   @default(PENDING)
  currentStep              ProvisioningStepKey? @map("current_step")
  requestedBy              String               @map("requested_by")
  correlationId            String?              @map("correlation_id") @db.VarChar(64)
  templateFromWhitelabelId Int?                 @map("template_from_whitelabel_id")
  errorCode                String?              @map("error_code") @db.VarChar(64)
  errorMessage             String?              @map("error_message") @db.VarChar(1000)
  delivery                 Json?
  startedAt                DateTime?            @map("started_at")
  completedAt              DateTime?            @map("completed_at")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")

  requestedByAdmin SuperAdmin                   @relation(fields: [requestedBy], references: [id])
  steps            WhitelabelProvisioningStep[]

  @@index([slug])
  @@index([whitelabelId])
  @@index([status])
  @@map("whitelabel_provisionings")
}

model WhitelabelProvisioningStep {
  id               String                 @id @default(cuid())
  provisioningId   String                 @map("provisioning_id")
  key              ProvisioningStepKey
  status           ProvisioningStepStatus @default(PENDING)
  attempts         Int                    @default(0)
  payload          Json?
  result           Json?
  lastErrorCode    String?                @map("last_error_code") @db.VarChar(64)
  lastErrorMessage String?                @map("last_error_message") @db.VarChar(1000)
  startedAt        DateTime?              @map("started_at")
  completedAt      DateTime?              @map("completed_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  provisioning WhitelabelProvisioning @relation(fields: [provisioningId], references: [id], onDelete: Cascade)

  @@unique([provisioningId, key])
  @@index([status])
  @@map("whitelabel_provisioning_steps")
}
